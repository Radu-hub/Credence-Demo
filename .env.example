# ─── PassGate Environment Configuration ──────────────────────────────────────
# Copy this file to `.env` and fill in your values.
#
#   cp .env.example .env

# Server
PORT=3000
NODE_ENV=development

# Policy — minimum age for access (ISO 8601 years)
MIN_AGE=21

# Operating Mode:
# Set to "false" to call the live Credence Cloud SDK API (with smart fallback).
# Set to "true" to force offline mock & presentation mode.
USE_MOCK=false

# Auto-simulation timer (only used in pure mock mode when set to "true")
AUTO_SIMULATE=false

# CredenceID Cloud SDK / API (Playground: https://credenceid.com/cloudsdk/playground)
CREDENCE_API_BASE_URL=https://credenceid.com/cloudsdk/playground
CREDENCE_API_KEY=CS_your-license-or-api-key-here
CREDENCE_TENANT_ID=your-tenant-or-profile-id-here
CREDENCE_PROFILE_ID=your-profile-id-here
CREDENCE_PROFILE_NAME="Age Check Profile 2.0"
CREDENCE_ORIGIN=http://localhost:3000

# Public Tunnel / Handoff URL (Optional: e.g. https://your-tunnel.ngrok-free.app for mobile camera testing)
PUBLIC_URL=http://localhost:3000
