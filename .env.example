# ─── PassGate Environment Configuration ──────────────────────────────────────
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env

# Server
PORT=3000
NODE_ENV=development

# Policy — minimum legal age threshold (ISO 8601 years)
MIN_AGE=21

# ─── Apple Developer "Verify with Wallet on the Web" Configuration ───────────
# W3C Digital Credentials API & ISO/IEC 18013-7 (Annex C)
#
# Merchant / Business ID registered in your Apple Developer account:
APPLE_MERCHANT_ID=merchant.com.yourcompany.passgate

# Path to your Apple Identity Access Certificate (X.509 DER or PEM format):
APPLE_READER_CERT_PATH=certs/apple-reader-cert.pem

# Path to your Apple Reader Private Key (PKCS#8 or SEC1 EC P-256 PEM format):
APPLE_READER_KEY_PATH=certs/apple-reader-key.pem

# Optional passphrase if your private key is encrypted:
# APPLE_READER_KEY_PASSPHRASE=your-key-passphrase

# Alternatively, pass raw PEM strings directly via environment variables:
# APPLE_READER_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# APPLE_READER_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Directory containing State DMV / Issuing Authority CA (IACA) root certificates (.cer, .crt, .pem, .der):
APPLE_IACA_ROOTS_PATH=certs/iaca

# Or a single IACA root certificate in PEM format:
# APPLE_IACA_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ─── Network & Public Tunnel Configuration ───────────────────────────────────
# Public URL for mobile testing (e.g. your active ngrok HTTPS tunnel)
PUBLIC_URL=http://localhost:3000

# ─── Optional: Credence Cloud SDK / Legacy Fallback ──────────────────────────
USE_MOCK=false
AUTO_SIMULATE=false
CREDENCE_API_BASE_URL=https://credenceid.com/cloudsdk/playground
CREDENCE_API_KEY=CS_your-license-or-api-key-here
CREDENCE_TENANT_ID=your-tenant-id-here
CREDENCE_PROFILE_ID=your-profile-id-here
CREDENCE_PROFILE_NAME="Age Check Profile 2.0"
CREDENCE_ORIGIN=http://localhost:3000
