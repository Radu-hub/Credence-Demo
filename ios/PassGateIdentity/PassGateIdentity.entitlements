<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple In-App Identity Presentment Entitlement for requesting mDL credentials from Apple Wallet -->
	<key>com.apple.developer.in-app-identity-presentment</key>
	<true/>
	<!-- PassKit Identity Verification capability -->
	<key>com.apple.developer.passkit.in-app-identity-presentation</key>
	<true/>
</dict>
</plist>
